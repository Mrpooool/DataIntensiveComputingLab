{
  "schema_version": "1.0.0",
  "prediction_task": "zone_hourly_taxi_demand",
  "training_dataset": {
    "coverage_start_utc": "2024-01-01 05:00:00",
    "coverage_end_utc_exclusive": "2024-07-01 04:00:00",
    "train_end_utc_exclusive": "2024-05-07 14:00:00",
    "validation_end_utc_exclusive": "2024-06-03 21:00:00",
    "expected_source_files": {
      "taxi": [
        "taxi_trips_update.parquet",
        "yellow_tripdata_2024-01.parquet",
        "yellow_tripdata_2024-02.parquet",
        "yellow_tripdata_2024-03.parquet"
      ],
      "weather": ["weather.csv", "weather_update.csv"],
      "air_quality": ["air_quality_update.csv", "hourly_88101_2024.csv"],
      "taxi_zones": ["taxi_zone_lookup.csv"]
    }
  },
  "analysis_timezone": "America/New_York",
  "key_columns": ["pickup_location_id", "target_hour_utc"],
  "timestamp_column": "target_hour_utc",
  "label_column": "trip_count",
  "split_column": "split",
  "split_values": {
    "train": "train",
    "validation": "validation",
    "test": "test"
  },
  "categorical_features": [
    "pickup_zone",
    "pickup_borough",
    "weather_coco_lag_1h"
  ],
  "numeric_features": [
    "demand_lag_1h",
    "demand_lag_24h",
    "demand_rolling_mean_24h",
    "weather_temp_lag_1h",
    "weather_prcp_lag_1h",
    "air_quality_pm25_lag_1h"
  ],
  "missing_indicator_features": [
    "weather_temp_lag_1h",
    "weather_prcp_lag_1h",
    "air_quality_pm25_lag_1h"
  ],
  "baseline_prediction_column": "demand_lag_24h",
  "imputer_strategy": "median",
  "scale_numeric": true,
  "model": {
    "type": "linear_regression",
    "reg_params": [0.0, 0.1],
    "elastic_net_params": [0.0],
    "max_iter": 50,
    "tolerance": 1e-06
  },
  "evaluation_metrics": ["rmse", "mae", "r2"],
  "reload_check_rows": 20
}
